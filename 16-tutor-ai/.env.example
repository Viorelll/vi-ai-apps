# Never put secrets in VITE_* variables. These local dummy values are not production credentials.
POSTGRES_DB=tutorai
POSTGRES_USER=tutorai
POSTGRES_PASSWORD=replace-with-local-db-password
S3_ROOT_USER=tutorai-local
S3_ROOT_PASSWORD=replace-with-local-storage-password
S3_BUCKET=tutorai
INTERNAL_API_KEY=replace-with-internal-key
AI_DEMO_MODE=false
FOUNDRY_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1/
FOUNDRY_API_KEY=replace-with-foundry-key
CHAT_DEPLOYMENT=replace-with-chat-deployment
JUDGE_DEPLOYMENT=replace-with-separate-judge-deployment
CU_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
CU_API_KEY=replace-with-cu-key
CU_ANALYZER=prebuilt-documentSearch
# Optional labs are disabled until separately implemented and configured.
