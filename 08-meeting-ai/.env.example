# Local-only demo credentials. Replace before exposing services outside localhost.
DB_PASSWORD=meetingai-local-change-me
MINIO_ROOT_USER=meetingai-storage
MINIO_ROOT_PASSWORD=meetingai-storage-local-change-me

# Azure Speech fast transcription. Leave placeholders for demo-only mode.
SPEECH_ENDPOINT=https://RESOURCE.cognitiveservices.azure.com/
SPEECH_API_KEY=replace-with-speech-key
SPEECH_LOCALE=ro-RO

# Microsoft Foundry chat deployment (Azure OpenAI compatible endpoint).
FOUNDRY_OPENAI_ENDPOINT=https://RESOURCE.openai.azure.com/openai/v1/
FOUNDRY_API_KEY=replace-with-foundry-key
CHAT_DEPLOYMENT=meetingai-chat
AI_PROVIDER=demo
