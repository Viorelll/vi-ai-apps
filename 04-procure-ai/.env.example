# Dummy values for private local development. Replace before using real data.
DB_PASSWORD=procureai-local-placeholder
MINIO_ROOT_USER=procureai-storage
MINIO_ROOT_PASSWORD=replace-with-storage-password
INTERNAL_API_KEY=replace-with-internal-key

# Demo is explicit and makes no model calls. Set Foundry to use the real provider.
AI_MODE=Demo
RAG_PROVIDER=NoRag
FOUNDRY_OPENAI_ENDPOINT=https://RESOURCE.openai.azure.com/openai/v1/
FOUNDRY_API_KEY=replace-with-resource-key
CHAT_DEPLOYMENT=procureai-chat
NEEDS_DEPLOYMENT=procureai-chat
SUPPLIERS_DEPLOYMENT=procureai-chat
COMPARE_DEPLOYMENT=procureai-chat
RECOMMEND_DEPLOYMENT=procureai-chat
CU_ENDPOINT=https://RESOURCE.cognitiveservices.azure.com
CU_API_KEY=replace-with-content-understanding-key
CU_ANALYZER=prebuilt-documentSearch
