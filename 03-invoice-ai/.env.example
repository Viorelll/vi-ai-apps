# Artificial local credentials; replace for a maintained deployment. Never commit .env.
DB_PASSWORD=dummy-db-password-change-me
MINIO_ROOT_USER=invoiceai-storage
MINIO_ROOT_PASSWORD=dummy-storage-password-change-me
INTERNAL_API_KEY=dummy-internal-key-change-me
WEB_PORT=8080
# Demo only processes samples/invoice.pdf and samples/receipt.pdf. Azure processes real documents.
AI_MODE=Demo
DOCINT_ENDPOINT=https://RESOURCE.cognitiveservices.azure.com/
DOCINT_KEY=dummy-document-intelligence-key
FOUNDRY_OPENAI_ENDPOINT=https://RESOURCE.openai.azure.com/openai/v1/
FOUNDRY_API_KEY=dummy-foundry-key
CHAT_DEPLOYMENT=invoiceai-chat

# Optional additional content safety; Azure content filters are configured on the resource.
PROMPT_SHIELDS_ENABLED=false
SAFETY_ENDPOINT=https://RESOURCE.cognitiveservices.azure.com/
SAFETY_KEY=dummy-content-safety-key
