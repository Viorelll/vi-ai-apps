{
  "ConnectionStrings": {
    "App": "Host=localhost;Port=55420;Database=evalai;Username=evalai;Password=replace-local-db-password"
  },
  "Internal": {
    "Key": "replace-local-internal-key"
  },
  "Storage": {
    "Endpoint": "http://localhost:59020",
    "AccessKey": "evalai-storage",
    "SecretKey": "replace-local-storage-password",
    "Bucket": "evalai"
  },
  "Ai": {
    "BaseUrl": "http://localhost:5101/"
  },
  "Foundry": {
    "Mode": "Demo",
    "OpenAiEndpoint": "https://RESOURCE.openai.azure.com/openai/v1/",
    "ApiKey": "replace-foundry-api-key",
    "CandidateA": "evalai-a",
    "CandidateB": "evalai-b",
    "JudgeDeployment": "evalai-judge",
    "CandidateA:PromptVersion": "candidate-v1",
    "CandidateB:PromptVersion": "candidate-v2"
  },
  "ContentUnderstanding": {
    "Endpoint": "https://RESOURCE.cognitiveservices.azure.com/",
    "ApiKey": "replace-content-understanding-key",
    "Analyzer": "prebuilt-documentSearch"
  },
  "Rag": {
    "Provider": "NoRag"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
