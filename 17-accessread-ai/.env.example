# Explicit demo: deterministic translation fixtures and local eSpeak narration, no Azure calls.
DEMO_MODE=true
DB_PASSWORD=replace-with-a-long-local-password
MINIO_ROOT_USER=accessreadai-storage
MINIO_ROOT_PASSWORD=replace-with-a-long-storage-password
INTERNAL_API_KEY=replace-with-a-random-internal-secret
FOUNDRY_OPENAI_ENDPOINT=https://RESOURCE.openai.azure.com/openai/v1/
FOUNDRY_API_KEY=replace-with-resource-key
CHAT_DEPLOYMENT=accessreadai-chat
LAYOUT_ENDPOINT=https://RESOURCE.cognitiveservices.azure.com/
LAYOUT_API_KEY=replace-with-document-intelligence-key
TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/
TRANSLATOR_API_KEY=replace-with-translator-key
TRANSLATOR_REGION=replace-region
SPEECH_TTS_ENDPOINT=https://REGION.tts.speech.microsoft.com/
SPEECH_API_KEY=replace-with-speech-key
