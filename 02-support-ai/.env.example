# Local placeholders. Never use these sample passwords on a shared network.
DB_PASSWORD=replace-with-a-long-local-password
MINIO_ROOT_USER=supportai-storage
MINIO_ROOT_PASSWORD=replace-with-a-long-storage-password
INTERNAL_API_KEY=replace-with-a-random-internal-secret
# Foundry is the real provider. Set AI_MODE=Demo explicitly for a credential-free laboratory.
AI_MODE=Foundry
FOUNDRY_OPENAI_ENDPOINT=https://RESOURCE.openai.azure.com/openai/v1/
FOUNDRY_API_KEY=replace-with-resource-key
CHAT_DEPLOYMENT=supportai-chat
CU_ENDPOINT=https://RESOURCE.cognitiveservices.azure.com/
CU_API_KEY=replace-with-content-understanding-key
# NoRag sends a bounded active-source snapshot to the model. No vector search is claimed.
RAG_PROVIDER=NoRag
WEB_PORT=8080

# Optional real Azure Prompt Shields. When enabled failures block inference.
PROMPT_SHIELDS_ENABLED=false
SAFETY_ENDPOINT=https://RESOURCE.cognitiveservices.azure.com/
SAFETY_API_KEY=replace-with-safety-key
# Optional OTLP collector endpoint: configure the process environment; no extra container required.
